# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# C extensions
*.pyd

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# User uploads & generated output (keep directory structure via .gitkeep)
uploads/*
!uploads/.gitkeep
generated/*
!generated/.gitkeep
logs/*
!logs/.gitkeep
*.log

# Satellite / geospatial raw temp formats (preserve demo_data)
*.jp2
*.hdf
*.h5
!demo_data/**/*.tif
!demo_data/**/*.tiff
!demo_data/*.tif
!demo_data/*.tiff

# Model weights & archives
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.zip
*.tar
*.tar.gz
*.tgz
# Preserve trained SatQuery RS model adapter & configs
!models/checkpoints/satquery_rs_model/
!models/checkpoints/satquery_rs_model/**

# Secrets, Environment & Certificates
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
.cloudflared/

